# Settings for the fork image workflow (.github/workflows/fork-image.yml).

# Upstream Jellyfin version this branch is based on. Image tags must start with it.
JELLYFIN_VERSION=12.1

# jellyfin-packaging release whose docker/Dockerfile builds the image.
PACKAGING_REF=v12.1-202609142034

# Framework versions jellyfin-packaging's build.py selects for this Jellyfin version.
DOTNET_VERSION=10.0
NODEJS_VERSION=24
